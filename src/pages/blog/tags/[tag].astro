---
import Base from '../../../layouts/Base.astro'
import { getPosts, fmtDate } from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort()
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, tags, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }))
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const { tag, tags, posts } = Astro.props
---

<Base title={`#${tag} — Blog`}>
  <main class="wrap page">
    <a class="back" href={`${base}/blog/`}>← Blog</a>
    <h1>#{tag}</h1>
    <div class="tags">
      {tags.map((t) => <a class:list={['tag', { on: t === tag }]} href={`${base}/blog/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
    </div>
    <ul class="list">
      {posts.map((p) => (
        <li><a href={`${base}/blog/${p.id}/`}><time>{fmtDate(p.data.date)}</time><span class="t">{p.data.title}</span><span class="arrow">→</span></a></li>
      ))}
    </ul>
  </main>
</Base>
