---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getPosts, fmtDate } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const { post } = Astro.props
const { Content } = await render(post)
---

<Base title={`${post.data.title} — Takumi Ogawa`}>
  <main class="wrap page">
    <a class="back" href={`${base}/blog/`}>← Blog</a>
    <article>
      <time class="post-meta">{fmtDate(post.data.date)}</time>
      <h1>{post.data.title}</h1>
      <div class="tags">
        {post.data.tags.map((t) => <a class="tag" href={`${base}/blog/tags/${encodeURIComponent(t)}/`}>#{t}</a>)}
      </div>
      <div class="prose"><Content /></div>
    </article>
  </main>
</Base>
