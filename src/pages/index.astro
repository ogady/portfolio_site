---
import Base from '../layouts/Base.astro'
import { user, skills, career, certifications, techBlog, works } from '../data/profile'
import { getRepos, getQiita, getSlides, getMedium } from '../lib/fetchers'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const [repos, qiita, slides, medium] = await Promise.all([getRepos(), getQiita(), getSlides(), getMedium()])
// 固定リスト（Medium以外の過去記事を含む）に、Mediumの最新記事をタイトル重複なしで統合する
const blogPosts = [...medium, ...techBlog.filter((t) => !medium.some((m) => m.title === t.title))].sort((a, b) =>
  b.date.localeCompare(a.date),
)
const years = new Date().getFullYear() - 2017
---

<Base>
  <header class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Manager, SRE & Data Platform / Data Enabling @ Eureka, Inc.</span>
        <h1>Takumi<br /><em>Ogawa</em>.</h1>
        <p class="lead">
          信頼性とデリバリーの速さを両立させるSRE。AWS / Kubernetes / Terraform を軸に、プラットフォームとデータ基盤を作って運用しています。
        </p>
        <div class="btns">
          <a class="btn primary" href="#career">Career を見る</a>
          <a class="btn" href={`${base}/blog/`}>Blog</a>
        </div>
        <ul class="social">
          <li><a href={`https://github.com/${user.github}`}>GitHub</a></li>
          <li><a href={`https://x.com/${user.twitter}`}>X</a></li>
          <li><a href={`https://www.linkedin.com/in/${user.linkedin}`}>LinkedIn</a></li>
          <li><a href={`https://www.facebook.com/${user.facebook}`}>Facebook</a></li>
        </ul>
        <div class="stats">
          <div><b>{years}+</b><span>years in engineering</span></div>
          <div><b>3</b><span>companies</span></div>
        </div>
      </div>
      <img class="avatar" src={`${base}/avatar.jpg`} alt="Takumi Ogawa" width="240" height="240" />
    </div>
  </header>

  <main>
    <section class="block" id="skills">
      <div class="wrap">
        <div class="sec-head"><span class="no">01</span><h2>Skills</h2></div>
        <div class="grid">
          {skills.map((s) => (
            <div class="card skill hover">
              <h3>{s.title}</h3>
              <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="block" id="career">
      <div class="wrap">
        <div class="sec-head"><span class="no">02</span><h2>Career</h2></div>
        <div class="timeline">
          {career.map((job) => (
            <article class="job card">
              <div class="job-head">
                <div>
                  <h3><a href={job.url}>{job.company}</a></h3>
                  <span class="role">{job.role}</span>
                </div>
                <time>{job.period}</time>
              </div>
              {job.projects.map((p) => (
                <div class="proj">
                  <h4>{p.title}{p.period && <small>{p.period}</small>}</h4>
                  <ul class="hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>
                  {p.stack && <ul class="chips sm">{p.stack.map((s) => <li>{s}</li>)}</ul>}
                </div>
              ))}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="block" id="certifications">
      <div class="wrap">
        <div class="sec-head"><span class="no">03</span><h2>Certifications</h2></div>
        <div class="grid">
          {certifications.map((c) => (
            <div class="card cert hover"><time>{c.date}</time><span>{c.name}</span></div>
          ))}
        </div>
      </div>
    </section>

    {repos.length > 0 && (
      <section class="block" id="projects">
        <div class="wrap">
          <div class="sec-head"><span class="no">04</span><h2>Projects</h2></div>
          <div class="grid">
            {repos.map((r) => (
              <a class="card repo" href={r.url}>
                <h3>{r.name}</h3>
                <p>{r.description ?? ''}</p>
                <div class="meta">
                  {r.language && <span>● {r.language}</span>}
                  <span>★ {r.stars}</span>
                </div>
              </a>
            ))}
          </div>
          <p class="more"><a class="btn" href={`https://github.com/${user.github}`}>More on GitHub →</a></p>
        </div>
      </section>
    )}

    <section class="block" id="talks">
      <div class="wrap">
        <div class="sec-head"><span class="no">05</span><h2>Talks</h2></div>
        {slides.length > 0 ? (
          <ul class="list">
            {slides.map((s) => (
              <li><a href={s.url}><time>{s.date}</time><span class="t">{s.title}</span><span class="arrow">↗</span></a></li>
            ))}
          </ul>
        ) : <p class="empty">スライドは Speaker Deck を見てください。</p>}
        <p class="more"><a class="btn" href={`https://speakerdeck.com/${user.speakerDeck}`}>More on Speaker Deck →</a></p>
      </div>
    </section>

    <section class="block" id="writing">
      <div class="wrap">
        <div class="sec-head"><span class="no">06</span><h2>Writing</h2></div>
        <h3 class="sub" style="margin-top:0">Tech Blog</h3>
        <ul class="list">
          {blogPosts.map((p) => (
            <li><a href={p.url}><time>{p.date}</time><span class="t">{p.title}</span><span class="arrow">↗</span></a></li>
          ))}
        </ul>
        {qiita.length > 0 && (
          <>
            <h3 class="sub">Qiita</h3>
            <ul class="list">
              {qiita.map((p) => (
                <li><a href={p.url}><time>{p.date}</time><span class="t">{p.title}</span><span class="arrow">↗</span></a></li>
              ))}
            </ul>
            <p class="more"><a class="btn" href={`https://qiita.com/${user.qiita}`}>More on Qiita →</a></p>
          </>
        )}
      </div>
    </section>

    <section class="block" id="works">
      <div class="wrap">
        <div class="sec-head"><span class="no">07</span><h2>Works</h2></div>
        <div class="grid">
          {works.map((w) => (
            <a class="card work" href={w.url}>
              <img src={w.image.startsWith('http') ? w.image : `${base}/${w.image}`} alt="" loading="lazy" />
              <h3>{w.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>
